    end

  end

  describe "PUT update" do

    describe "with valid params" do
      it "updates the requested DynamicName__137" do
        DynamicName__138.should_receive(:find).with("37").and_return(mock_DynamicName__137)
        mock_DynamicName__137.should_receive(:update_attributes).with({'these' => 'params'})
        put :update, :id => "37", :DynamicName__137 => {:these => 'params'}
      end

      it "assigns the requested DynamicName__137 as @DynamicName__137" do
        DynamicName__138.stub(:find).and_return(mock_DynamicName__137(:update_attributes => true))
        put :update, :id => "1"
        assigns[:DynamicName__137].should equal(mock_DynamicName__137)
      end

      it "redirects to the DynamicName__137" do
        DynamicName__138.stub(:find).and_return(mock_DynamicName__137(:update_attributes => true))
        put :update, :id => "1"
        response.should redirect_to(DynamicName__141_url(mock_DynamicName__137))
      end
    end

    describe "with invalid params" do
      it "updates the requested DynamicName__137" do
        DynamicName__138.should_receive(:find).with("37").and_return(mock_DynamicName__137)
        mock_DynamicName__137.should_receive(:update_attributes).with({'these' => 'params'})
        put :update, :id => "37", :DynamicName__137 => {:these => 'params'}
      end

      it "assigns the DynamicName__137 as @DynamicName__137" do
        DynamicName__138.stub(:find).and_return(mock_DynamicName__137(:update_attributes => false))
