  end

  describe "POST create" do

    describe "with valid params" do
      it "assigns a newly created DynamicName__137 as @DynamicName__137" do
        DynamicName__138.stub(:new).with({'these' => 'params'}).and_return(mock_DynamicName__137(:save => true))
        post :create, :DynamicName__137 => {:these => 'params'}
        assigns[:DynamicName__137].should equal(mock_DynamicName__137)
      end

      it "redirects to the created DynamicName__137" do
        DynamicName__138.stub(:new).and_return(mock_DynamicName__137(:save => true))
        post :create, :DynamicName__137 => {}
        response.should redirect_to(DynamicName__141_url(mock_DynamicName__137))
      end
    end

    describe "with invalid params" do
      it "assigns a newly created but unsaved DynamicName__137 as @DynamicName__137" do
        DynamicName__138.stub(:new).with({'these' => 'params'}).and_return(mock_DynamicName__137(:save => false))
        post :create, :DynamicName__137 => {:these => 'params'}
        assigns[:DynamicName__137].should equal(mock_DynamicName__137)
      end

      it "re-renders the 'new' template" do
        DynamicName__138.stub(:new).and_return(mock_DynamicName__137(:save => false))
