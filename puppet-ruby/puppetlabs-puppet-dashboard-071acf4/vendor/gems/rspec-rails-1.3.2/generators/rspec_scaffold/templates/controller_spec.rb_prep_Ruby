require 'spec_helper'

describe DynamicName__136Controller do

  def mock_DynamicName__137(stubs={})
    @mock_DynamicName__137 ||= mock_model(DynamicName__138, stubs)
  end

  describe "GET index" do
    it "assigns all DynamicName__139 as @DynamicName__139" do
      DynamicName__138.stub(:find).with(:all).and_return([mock_DynamicName__137])
      get :index
      assigns[:DynamicName__140].should == [mock_DynamicName__137]
    end
  end

  describe "GET show" do
    it "assigns the requested DynamicName__137 as @DynamicName__137" do
      DynamicName__138.stub(:find).with("37").and_return(mock_DynamicName__137)
      get :show, :id => "37"
      assigns[:DynamicName__137].should equal(mock_DynamicName__137)
    end
  end

  describe "GET new" do
    it "assigns a new DynamicName__137 as @DynamicName__137" do
      DynamicName__138.stub(:new).and_return(mock_DynamicName__137)
      get :new
      assigns[:DynamicName__137].should equal(mock_DynamicName__137)
    end
  end

  describe "GET edit" do
    it "assigns the requested DynamicName__137 as @DynamicName__137" do
      DynamicName__138.stub(:find).with("37").and_return(mock_DynamicName__137)
