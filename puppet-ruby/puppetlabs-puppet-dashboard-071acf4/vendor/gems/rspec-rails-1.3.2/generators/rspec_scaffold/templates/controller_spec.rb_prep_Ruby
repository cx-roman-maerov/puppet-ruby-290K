      end

      it "re-renders the 'edit' template" do
        DynamicName__138.stub(:find).and_return(mock_DynamicName__137(:update_attributes => false))
        put :update, :id => "1"
        response.should render_template('edit')
      end
    end

  end

  describe "DELETE destroy" do
    it "destroys the requested DynamicName__137" do
      DynamicName__138.should_receive(:find).with("37").and_return(mock_DynamicName__137)
      mock_DynamicName__137.should_receive(:destroy)
      delete :destroy, :id => "37"
    end

    it "redirects to the DynamicName__140 list" do
      DynamicName__138.stub(:find).and_return(mock_DynamicName__137(:destroy => true))
      delete :destroy, :id => "1"
