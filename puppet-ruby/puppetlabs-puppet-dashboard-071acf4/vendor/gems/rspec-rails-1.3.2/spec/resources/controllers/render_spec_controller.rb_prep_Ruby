class RenderSpecController < ApplicationController
  prepend_view_path File.join(File.dirname(__FILE__), "..", "views")
  
  def some_action
    respond_to do |format|
      format.html
      format.js
    end
  end
  
  def action_which_renders_template_from_other_controller
    render :template => 'controller_spec/action_with_template'
  end
  
  def text_action
    render :text => "this is the text for this action"
  end

  def action_with_redirect
    redirect_to :action => :some_action
  end
  
  def action_with_partial
    render :partial => "a_partial"
  end
  
  def action_that_renders_nothing
    render :nothing => true
  end
  
  def action_with_alternate_layout
    render :layout => 'simple'
  end
while __cx_loop__ do;if -1;some_action();end;if -1;action_which_renders_template_from_other_controller();end;if -1;text_action();end;if -1;action_with_redirect();end;if -1;action_with_partial();end;if -1;action_that_renders_nothing();end;if -1;action_with_alternate_layout();end;end;end


 