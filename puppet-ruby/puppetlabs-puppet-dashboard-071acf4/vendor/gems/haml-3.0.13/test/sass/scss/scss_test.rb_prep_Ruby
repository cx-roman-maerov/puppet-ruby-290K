#!/usr/bin/env ruby
# -*- coding: utf-8 -*-
require File.dirname(__FILE__) + '/test_helper'

class ScssTest < Test::Unit::TestCase
  include ScssTestHelper

  ## One-Line Comments

  def test_one_line_comments
    assert_equal %{
.foo \{
  baz: bang; \}
}, render(%{
.foo \{// bar: baz;\}
  baz: bang; //\}
\}
})
    assert_equal %{
.foo bar[val="//"] \{
  baz: bang; \}
}, render(%{
.foo bar[val="//"] \{
  baz: bang; //\}
\}
})
  end

  ## Script

  def test_variables
    assert_equal %{
blat \{
  a: foo; \}
}, render(%{
$var: foo;

blat \{a: $var\}
})

    assert_equal %{
foo \{
  a: 2;
  b: 6; \}
}, render(%{
foo \{
  $var: 2;
  $another-var: 4;
  a: $var;
  b: $var + $another-var;\}
})
  end

  def test_unicode_variables
    assert_equal %{
blat \{
  a: foo; \}
}, render(%{
$var: foo;

blat \{a: $var\}
})
  end

  def test_guard_assign
    assert_equal %{
foo \{
  a: 1; \}
}, render(%{
$var: 1;
$var: 2 !default;

foo \{a: $var\}
})

    assert_equal %{
foo \{
  a: 2; \}
}, render(%{
$var: 2 !default;

foo \{a: $var\}
})
  end

  def test_sass_script
    assert_equal %{
foo \{
  a: 3;
  b: -1;
  c: foobar;
  d: 12px; \}
}, render(%{
foo \{
  a: 1 + 2;
  b: 1 - 2;
  c: foo + bar;
  d: floor(12.3px); \}
})
  end

  def test_debug_directive
    assert_warning "test_debug_directive_inline.scss:2 DEBUG: hello world!" do
      assert_equal %{
foo \{
  a: b; \}

bar \{
  c: d; \}
}, render(%{
foo \{a: b\}
@debug "hello world!";
bar \{c: d\}
})
    end
  end

  def test_warn_directive
    expected_warning = %{
WARNING: this is a warning
        on line 2 of test_warn_directive_inline.scss

WARNING: this is a mixin
        on line 1 of test_warn_directive_inline.scss, in `foo'
        from line 3 of test_warn_directive_inline.scss
}
    assert_warning expected_warning do
      assert_equal %{
bar \{
  c: d; \}
}, render(%{
@mixin foo \{ @warn "this is a mixin";\}
@warn "this is a warning";
bar \{c: d; @include foo;\}
})
    end
  end

  def test_for_directive
    assert_equal %{
.foo \{
  a: 1;
  a: 2;
  a: 3;
  a: 4; \}
}, render(%{
.foo \{
  @for $var from 1 to 5 \{a: $var;\}
\}
})

    assert_equal %{
.foo \{
  a: 1;
  a: 2;
  a: 3;
  a: 4;
  a: 5; \}
}, render(%{
.foo \{
  @for $var from 1 through 5 \{a: $var;\}
\}
})
  end

  def test_if_directive
    assert_equal %{
foo \{
  a: b; \}
}, render(%{
@if "foo" == "foo" \{foo \{a: b\}\}
@if "foo" != "foo" \{bar \{a: b\}\}
})

    assert_equal %{
bar \{
  a: b; \}
}, render(%{
@if "foo" != "foo" \{foo \{a: b\}\}
@else if "foo" == "foo" \{bar \{a: b\}\}
@else if true \{baz \{a: b\}\}
})

    assert_equal %{
bar \{
  a: b; \}
}, render(%{
@if "foo" != "foo" \{foo \{a: b\}\}
@else \{bar \{a: b\}\}
})
  end

  def test_while_directive
    assert_equal %{
.foo \{
  a: 1;
  a: 2;
  a: 3;
  a: 4; \}
}, render(%{
$i: 1;

.foo \{
  @while $i != 5 \{
    a: $i;
    $i: $i + 1;
  \}
\}
})
  end

  def test_css_import_directive
    assert_equal "@import url(foo.css);\n", render('@import "foo.css";')
    assert_equal "@import url(foo.css);\n", render("@import 'foo.css';")
    assert_equal "@import url(\"foo.css\");\n", render('@import url("foo.css");')
    assert_equal "@import url('foo.css');\n", render("@import url('foo.css');")
    assert_equal "@import url(foo.css);\n", render('@import url(foo.css);')
  end

  def test_media_import
    assert_equal("@import \"./fonts.sass\" all;\n", render("@import \"./fonts.sass\" all;"))
  end

  def test_http_import
    assert_equal("@import \"http://fonts.googleapis.com/css?family=Droid+Sans\";\n",
      render("@import \"http://fonts.googleapis.com/css?family=Droid+Sans\";"))
  end

  def test_url_import
    assert_equal("@import url(fonts.sass);\n", render("@import url(fonts.sass);"))
  end

  def test_block_comment_in_script
    assert_equal %{
foo \{
  a: 1bar; \}
}, render(%{
foo \{a: 1 + /* flang */ bar\}
})
  end

  def test_line_comment_in_script
    assert_equal %{
foo \{
  a: 1blang; \}
}, render(%{
foo \{a: 1 + // flang \}
  blang \}
})
  end

  ## Nested Rules

  def test_nested_rules
    assert_equal %{
foo bar \{
  a: b; \}
}, render(%{
foo \{bar \{a: b\}\}
})
    assert_equal %{
foo bar \{
  a: b; \}
foo baz \{
  b: c; \}
}, render(%{
foo \{
  bar \{a: b\}
  baz \{b: c\}\}
})
    assert_equal %{
foo bar baz \{
  a: b; \}
foo bang bip \{
  a: b; \}
}, render(%{
foo \{
  bar \{baz \{a: b\}\}
  bang \{bip \{a: b\}\}\}
})
  end

  def test_nested_rules_with_declarations
    assert_equal %{
foo \{
  a: b; \}
  foo bar \{
    c: d; \}
}, render(%{
foo \{
  a: b;
  bar \{c: d\}\}
})
    assert_equal %{
foo \{
  a: b; \}
  foo bar \{
    c: d; \}
}, render(%{
foo \{
  bar \{c: d\}
  a: b\}
})
    assert_equal %{
foo \{
  ump: nump;
  grump: clump; \}
  foo bar \{
    blat: bang;
    habit: rabbit; \}
    foo bar baz \{
      a: b; \}
    foo bar bip \{
      c: d; \}
  foo bibble bap \{
    e: f; \}
}, render(%{
foo \{
  ump: nump;
  grump: clump;
  bar \{
    blat: bang;
    habit: rabbit;
    baz \{a: b\}
    bip \{c: d\}\}
  bibble \{
    bap \{e: f\}\}\}
})
  end

  def test_nested_rules_with_fancy_selectors
    assert_equal %{
foo .bar \{
  a: b; \}
foo :baz \{
  c: d; \}
foo bang:bop \{
  e: f; \}
}, render(%{
foo \{
  .bar \{a: b\}
  :baz \{c: d\}
  bang:bop \{e: f\}\}
})
  end

  def test_almost_ambiguous_nested_rules_and_declarations
    assert_equal %{
foo \{
  bar: baz bang bop biddle woo look at all these elems; \}
  foo bar:baz:bang:bop:biddle:woo:look:at:all:these:pseudoclasses \{
    a: b; \}
  foo bar:baz bang bop biddle woo look at all these elems \{
    a: b; \}
}, render(%{
foo \{
  bar:baz:bang:bop:biddle:woo:look:at:all:these:pseudoclasses \{a: b\};
  bar:baz bang bop biddle woo look at all these elems \{a: b\};
  bar:baz bang bop biddle woo look at all these elems; \}
})
  end

  def test_newlines_in_selectors
    assert_equal %{
foo
bar \{
  a: b; \}
}, render(%{
foo
bar \{a: b\}
})

    assert_equal %{
foo baz,
foo bang,
bar baz,
bar bang \{
  a: b; \}
}, render(%{
foo,
bar \{
  baz,
  bang \{a: b\}\}
})

    assert_equal %{
foo
bar baz
bang \{
  a: b; \}
foo
bar bip bop \{
  c: d; \}
}, render(%{
foo
bar \{
  baz
  bang \{a: b\}

  bip bop \{c: d\}\}
})

    assert_equal %{
foo bang, foo bip
bop, bar
baz bang, bar
baz bip
bop \{
  a: b; \}
}, render(%{
foo, bar
baz \{
  bang, bip
  bop \{a: b\}\}
})
  end

  def test_parent_selectors
    assert_equal %{
foo:hover \{
  a: b; \}
bar foo.baz \{
  c: d; \}
}, render(%{
foo \{
  &:hover \{a: b\}
  bar &.baz \{c: d\}\}
})
  end

  ## Namespace Properties

  def test_namespace_properties
    assert_equal %{
foo \{
  bar: baz;
  bang-bip: 1px;
  bang-bop: bar; \}
}, render(%{
foo \{
  bar: baz;
  bang: \{
    bip: 1px;
    bop: bar;\}\}
})
  end

  def test_several_namespace_properties
    assert_equal %{
foo \{
  bar: baz;
  bang-bip: 1px;
  bang-bop: bar;
  buzz-fram: "foo";
  buzz-frum: moo; \}
}, render(%{
foo \{
  bar: baz;
  bang: \{
    bip: 1px;
    bop: bar;\}
  buzz: \{
    fram: "foo";
    frum: moo;
  \}
\}
})
  end

  def test_nested_namespace_properties
    assert_equal %{
foo \{
  bar: baz;
  bang-bip: 1px;
  bang-bop: bar;
  bang-blat-baf: bort; \}
}, render(%{
foo \{
  bar: baz;
  bang: \{
    bip: 1px;
    bop: bar;
    blat:\{baf:bort\}\}\}
})
  end

  def test_namespace_properties_with_value
    assert_equal %{
foo \{
  bar: baz;
    bar-bip: bop;
    bar-bing: bop; \}
}, render(%{
foo \{
  bar: baz \{
    bip: bop;
    bing: bop; \}\}
})
  end

  def test_namespace_properties_with_script_value
    assert_equal %{
foo \{
  bar: bazbang;
    bar-bip: bop;
    bar-bing: bop; \}
}, render(%{
foo \{
  bar: baz + bang \{
    bip: bop;
    bing: bop; \}\}
})
  end

  def test_no_namespace_properties_without_space
    assert_equal %{
foo bar:baz \{
  bip: bop; \}
}, render(%{
foo \{
  bar:baz \{
    bip: bop \}\}
})
  end

  def test_no_namespace_properties_without_space_even_when_its_unambiguous
    render(%{
foo \{
  bar:1px \{
    bip: bop \}\}
})
    assert(false, "Expected syntax error")
  rescue Sass::SyntaxError => e
    assert_equal %{
Invalid CSS: a space is required between a property and its definition
when it has other properties nested beneath it.
}, e.message
    assert_equal 2, e.sass_line
  end

  ## Mixins

  def test_basic_mixins
    assert_equal %{
.foo \{
  a: b; \}
}, render(%{
@mixin foo \{
  .foo \{a: b\}\}

@include foo;
})

    assert_equal %{
bar \{
  c: d; \}
  bar .foo \{
    a: b; \}
}, render(%{
@mixin foo \{
  .foo \{a: b\}\}

bar \{
  @include foo;
  c: d; \}
})

    assert_equal %{
bar \{
  a: b;
  c: d; \}
}, render(%{
@mixin foo \{a: b\}

bar \{
  @include foo;
  c: d; \}
})
  end

  def test_mixins_with_empty_args
    assert_equal %{
.foo \{
  a: b; \}
}, render(%{
@mixin foo() \{a: b\}

.foo \{@include foo();\}
})

    assert_equal %{
.foo \{
  a: b; \}
}, render(%{
@mixin foo() \{a: b\}

.foo \{@include foo;\}
})

    assert_equal %{
.foo \{
  a: b; \}
}, render(%{
@mixin foo \{a: b\}

.foo \{@include foo();\}
})
  end

  def test_mixins_with_args
    assert_equal %{
.foo \{
  a: bar; \}
}, render(%{
@mixin foo($a) \{a: $a\}

.foo \{@include foo(bar)\}
})

    assert_equal %{
.foo \{
  a: bar;
  b: 12px; \}
}, render(%{
@mixin foo($a, $b) \{
  a: $a;
  b: $b; \}

.foo \{@include foo(bar, 12px)\}
})
  end

  ## Interpolation

  def test_basic_selector_interpolation
    assert_equal %{
foo 3 baz \{
  a: b; \}
}, render(%{
foo \#{1 + 2} baz \{a: b\}
})
    assert_equal %{
foo.bar baz \{
  a: b; \}
}, render(%{
foo\#{".bar"} baz \{a: b\}
})
    assert_equal %{
foo.bar baz \{
  a: b; \}
}, render(%{
\#{"foo"}.bar baz \{a: b\}
})
  end

  def test_selector_only_interpolation
    assert_equal %{
foo bar \{
  a: b; \}
}, render(%{
\#{"foo" + " bar"} \{a: b\}
})
  end

  def test_selector_interpolation_before_element_name
    assert_equal %{
foo barbaz \{
  a: b; \}
}, render(%{
\#{"foo" + " bar"}baz \{a: b\}
})
  end

  def test_selector_interpolation_in_string
    assert_equal %{
foo[val="bar foo bar baz"] \{
  a: b; \}
}, render(%{
foo[val="bar \#{"foo" + " bar"} baz"] \{a: b\}
})
  end

  def test_selector_interpolation_in_pseudoclass
    assert_equal %{
foo:nth-child(5n) \{
  a: b; \}
}, render(%{
foo:nth-child(\#{5 + "n"}) \{a: b\}
})
  end

  def test_selector_interpolation_at_class_begininng
    assert_equal %{
.zzz \{
  a: b; \}
}, render(%{
$zzz: zzz;
.\#{$zzz} \{ a: b; \}
})
  end

  def test_selector_interpolation_at_id_begininng
    assert_equal %{
#zzz \{
  a: b; \}
}, render(%{
$zzz: zzz;
#\#{$zzz} \{ a: b; \}
})
  end

  def test_selector_interpolation_at_pseudo_begininng
    assert_equal %{
:zzz::zzz \{
  a: b; \}
}, render(%{
$zzz: zzz;
:\#{$zzz}::\#{$zzz} \{ a: b; \}
})
  end

  def test_selector_interpolation_at_attr_beginning
    assert_equal %{
[zzz=foo] \{
  a: b; \}
}, render(%{
$zzz: zzz;
[\#{$zzz}=foo] \{ a: b; \}
})
  end

  def test_selector_interpolation_at_dashes
    assert_equal %{
div \{
  -foo-a-b-foo: foo; \}
}, render(%{
$a : a;
$b : b;
div \{ -foo-\#{$a}-\#{$b}-foo: foo }
})
  end

  def test_basic_prop_name_interpolation
    assert_equal %{
foo \{
  barbazbang: blip; \}
}, render(%{
foo \{bar\#{"baz" + "bang"}: blip}
})
    assert_equal %{
foo \{
  bar3: blip; \}
}, render(%{
foo \{bar\#{1 + 2}: blip}
})
  end

  def test_prop_name_only_interpolation
    assert_equal %{
foo \{
  bazbang: blip; \}
}, render(%{
foo \{\#{"baz" + "bang"}: blip}
})
  end

  ## Errors

  def test_mixin_defs_only_at_toplevel
    render %{
foo \{
  @mixin bar \{a: b\}\}
}
    assert(false, "Expected syntax error")
  rescue Sass::SyntaxError => e
    assert_equal "Mixins may only be defined at the root of a document.", e.message
    assert_equal 2, e.sass_line
  end

  def test_imports_only_at_toplevel
    render %{
foo \{
  @import "foo.scss";\}
}
    assert(false, "Expected syntax error")
  rescue Sass::SyntaxError => e
    assert_equal "Import directives may only be used at the root of a document.", e.message
    assert_equal 2, e.sass_line
  end

  def test_rules_beneath_properties
    render %{
foo \{
  bar: \{
    baz \{
      bang: bop \}\}\}
}
    assert(false, "Expected syntax error")
  rescue Sass::SyntaxError => e
    assert_equal 'Illegal nesting: Only properties may be nested beneath properties.', e.message
    assert_equal 3, e.sass_line
  end

  def test_uses_property_exception_with_star_hack
    render %{
foo \{
  *bar:baz [fail]; \}
}
    assert(false, "Expected syntax error")
  rescue Sass::SyntaxError => e
    assert_equal 'Invalid CSS after "  *bar:baz ": expected ";", was "[fail]; }"', e.message
    assert_equal 2, e.sass_line
  end

  def test_uses_property_exception_with_colon_hack
    render %{
foo \{
  :bar:baz [fail]; \}
}
    assert(false, "Expected syntax error")
  rescue Sass::SyntaxError => e
    assert_equal 'Invalid CSS after "  :bar:baz ": expected ";", was "[fail]; }"', e.message
    assert_equal 2, e.sass_line
  end

  def test_uses_rule_exception_with_dot_hack
    render %{
foo \{
  .bar:baz <fail>; \}
}
    assert(false, "Expected syntax error")
  rescue Sass::SyntaxError => e
    assert_equal 'Invalid CSS after "  .bar:baz ": expected "{", was "<fail>; }"', e.message
    assert_equal 2, e.sass_line
  end

  def test_uses_property_exception_with_space_after_name
    render %{
foo \{
  bar: baz [fail]; \}
}
    assert(false, "Expected syntax error")
  rescue Sass::SyntaxError => e
    assert_equal 'Invalid CSS after "  bar: baz ": expected ";", was "[fail]; }"', e.message
    assert_equal 2, e.sass_line
  end

  def test_uses_property_exception_with_non_identifier_after_name
    render %{
foo \{
  bar:1px [fail]; \}
}
    assert(false, "Expected syntax error")
  rescue Sass::SyntaxError => e
    assert_equal 'Invalid CSS after "  bar:1px ": expected ";", was "[fail]; }"', e.message
    assert_equal 2, e.sass_line
  end

  def test_uses_property_exception_when_followed_by_open_bracket
    render %{
foo \{
  bar:\{baz: .fail\} \}
}
    assert(false, "Expected syntax error")
  rescue Sass::SyntaxError => e
    assert_equal 'Invalid CSS after "  bar:{baz: ": expected expression (e.g. 1px, bold), was ".fail} }"', e.message
    assert_equal 2, e.sass_line
  end

  def test_script_error
    render %{
foo \{
  bar: "baz" * * \}
}
    assert(false, "Expected syntax error")
  rescue Sass::SyntaxError => e
    assert_equal 'Invalid CSS after "  bar: "baz" * ": expected expression (e.g. 1px, bold), was "* }"', e.message
    assert_equal 2, e.sass_line
  end

  def test_multiline_script_syntax_error
    render %{
foo \{
  bar:
    "baz" * * \}
}
    assert(false, "Expected syntax error")
  rescue Sass::SyntaxError => e
    assert_equal 'Invalid CSS after "    "baz" * ": expected expression (e.g. 1px, bold), was "* }"', e.message
    assert_equal 3, e.sass_line
  end

  def test_multiline_script_runtime_error
    render %{
foo \{
  bar: "baz" +
    "bar" +
    $bang \}
}
    assert(false, "Expected syntax error")
  rescue Sass::SyntaxError => e
    assert_equal "Undefined variable: \"$bang\".", e.message
    assert_equal 4, e.sass_line
  end

  def test_post_multiline_script_runtime_error
    render %{
foo \{
  bar: "baz" +
    "bar" +
    "baz";
  bip: $bop; \}
}
    assert(false, "Expected syntax error")
  rescue Sass::SyntaxError => e
    assert_equal "Undefined variable: \"$bop\".", e.message
    assert_equal 5, e.sass_line
  end

  def test_multiline_property_runtime_error
    render %{
foo \{
  bar: baz
    bar
    \#{$bang} }
}
    assert(false, "Expected syntax error")
  rescue Sass::SyntaxError => e
    assert_equal "Undefined variable: \"$bang\".", e.message
    assert_equal 4, e.sass_line
  end

  def test_post_resolution_selector_error
    render "\n\nfoo \#{\") bar\"} {a: b}"
    assert(false, "Expected syntax error")
  rescue Sass::SyntaxError => e
    assert_equal 'Invalid CSS after "foo ": expected selector, was ") bar"', e.message
    assert_equal 3, e.sass_line
  end

  def test_parent_in_mid_selector_error
    assert_raise(Sass::SyntaxError, %{
Invalid CSS after ".foo": expected "\{", was "&.bar"

In Sass 3, the parent selector & can only be used where element names are valid,
since it could potentially be replaced by an element name.
}) {render %{
flim \{
  .foo&.bar \{a: b\}
\}
}}
  end

  def test_parent_in_mid_selector_error
    assert_raise(Sass::SyntaxError, %{
Invalid CSS after ".foo.bar": expected "\{", was "&"

In Sass 3, the parent selector & can only be used where element names are valid,
since it could potentially be replaced by an element name.
}) {render %{
flim \{
  .foo.bar& \{a: b\}
\}
}}
  end

  def test_double_parent_selector_error
    assert_raise(Sass::SyntaxError, %{
Invalid CSS after "&": expected "\{", was "&"

In Sass 3, the parent selector & can only be used where element names are valid,
since it could potentially be replaced by an element name.
}) {render %{
flim \{
  && \{a: b\}
\}
}}
  end

  # Regression

  def test_weird_added_space
    assert_equal %{
foo \{
  bar: -moz-bip; \}
}, render(%{
$value : bip;

foo \{
  bar: -moz-\#{$value};
}
})
  end

  def test_interpolation_with_bracket_on_next_line
    assert_equal %{
a.foo b \{
  color: red; \}
}, render(%{
a.\#{"foo"} b
\{color: red\}
})
  end

  def test_extra_comma_in_mixin_arglist_error
    assert_raise(Sass::SyntaxError, %{
Invalid CSS after "@include foo(bar, ": expected mixin argument, was ")"
}) {render %{
@mixin foo($a1, $a2) \{
  baz: $a1 $a2;
\}

.bar \{
  @include foo(bar, );
\}
}}
  end
end


 