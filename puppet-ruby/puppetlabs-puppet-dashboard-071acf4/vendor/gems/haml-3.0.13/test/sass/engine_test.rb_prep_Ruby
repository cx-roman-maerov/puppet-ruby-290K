  a-\#{$bar}
    b: c
}))}
  end

  def test_while
    assert_equal(%{
a-5 \{
  blooble: gloop; \}

a-4 \{
  blooble: gloop; \}

a-3 \{
  blooble: gloop; \}

a-2 \{
  blooble: gloop; \}

a-1 \{
  blooble: gloop; \}
}, render(%{
$a: 5
@while $a != 0
  a-\#{$a}
    blooble: gloop
  $a: $a - 1
}))
  end

  def test_else
    assert_equal(%{
a \{
  t1: t;
  t2: t;
  t3: t;
  t4: t; \}
}, render(%{
a
  @if true
    t1: t
  @else
    f1: f

  @if false
    f2: f
  @else
    t2: t

  @if false
    f3: f1
  @else if 1 + 1 == 3
    f3: f2
  @else
    t3: t

  @if false
    f4: f1
  @else if 1 + 1 == 2
    t4: t
  @else
    f4: f2

  @if false
    f5: f1
  @else if false
    f5: f2
}))
  end

