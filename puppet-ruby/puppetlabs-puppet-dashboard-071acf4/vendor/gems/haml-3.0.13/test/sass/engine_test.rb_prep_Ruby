  def test_guarded_assign
    assert_equal("foo {\n  a: b; }\n", render(%Q{$foo: b\n$foo: c !default\nfoo\n  a: $foo}))
    assert_equal("foo {\n  a: b; }\n", render(%Q{$foo: b !default\nfoo\n  a: $foo}))
  end
  
  def test_mixins
    renders_correctly "mixins", { :style => :expanded }
  end

  def test_directive_style_mixins
    assert_equal %{
bar \{
  prop: baz; \}
}, render(%{
@mixin foo($arg)
  prop: $arg

bar
  @include foo(baz)
})
  end

  def test_mixins_dont_interfere_with_sibling_combinator
    assert_equal("foo + bar {\n  a: b; }\nfoo + baz {\n  c: d; }\n",
                 render("foo\n  +\n    bar\n      a: b\n    baz\n      c: d"))
  end

  def test_mixin_args
    assert_equal("blat {\n  baz: hi; }\n", render(%{
=foo($bar)
  baz: $bar
blat
  +foo(hi)
}))
    assert_equal("blat {\n  baz: 3; }\n", render(%{
=foo($a, $b)
  baz: $a + $b
blat
  +foo(1, 2)
}))
    assert_equal("blat {\n  baz: 4;\n  baz: 3;\n  baz: 5;\n  bang: 3; }\n", render(%{
=foo($c: (6 + 4) / 2)
  baz: $c
$c: 3
blat
  +foo($c + 1)
  +foo(($c + 3)/2)
  +foo
  bang: $c
}))
  end

  def test_default_values_for_mixin_arguments
    assert_equal("white {\n  color: white; }\n\nblack {\n  color: black; }\n", render(%{
=foo($a: #FFF)
  :color $a
white
  +foo
black
  +foo(#000)
}))
    assert_equal(%{
one \{
  color: white;
  padding: 1px;
  margin: 4px; \}

two \{
  color: white;
  padding: 2px;
  margin: 5px; \}

three \{
  color: white;
  padding: 2px;
  margin: 3px; \}
}, render(%{
$a: 5px
=foo($a, $b: 1px, $c: 3px + $b)
  :color $a
  :padding $b
  :margin $c
one
  +foo(#fff)
two
  +foo(#fff, 2px)
three
  +foo(#fff, 2px, 3px)
}))
  end

  def test_hyphen_underscore_insensitive_mixins
    assert_equal(%{
