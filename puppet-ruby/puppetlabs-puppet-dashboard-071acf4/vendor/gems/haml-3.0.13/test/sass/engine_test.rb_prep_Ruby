  def test_comments_at_the_top_of_a_document
    render(%{
//
  This is a comment that
  continues to the second line.
foo
  bar: baz
})
  end

  def test_loud_comments_containing_a_comment_close
    actual_css = render(%{
/*
  This is a comment that
  continues to the second line. */
foo
  bar: baz
})
assert_equal(%{
/* This is a comment that
 * continues to the second line. */
foo \{
  bar: baz; \}
}, actual_css)
  end

  def test_loud_comments_with_starred_lines
    assert_equal(%{
/* This is a comment that
 * continues to the second line.
 * And even to the third! */
}, render(%{
/* This is a comment that
 * continues to the second line.
 * And even to the third!
}))
  end

  def test_loud_comments_with_no_space_after_starred_lines
    assert_equal(%{
/*bip bop
 *beep boop
 *bap blimp */
}, render(%{
/*bip bop
 *beep boop
 *bap blimp
}))
  end

  def test_comment_indentation_at_beginning_of_doc
    assert_equal %{
/* foo
 * bar
 *   baz */
foo \{
  a: b; \}
}, render(%{
/* foo
   bar
     baz
foo
  a: b
})
  end

  def test_unusual_comment_indentation
    assert_equal %{
foo \{
  /* foo
   * bar
   *   baz */ \}
}, render(%{
foo
  /* foo
     bar
       baz
})
  end

  def test_attribute_selector_with_spaces
    assert_equal(%{
a b[foo=bar] \{
  c: d; \}
}, render(%{
a
  b[foo = bar]
    c: d
}))
  end

  def test_quoted_colon
    assert_equal(%{
a b[foo="bar: baz"] \{
  c: d; \}
}, render(%{
a
  b[foo="bar: baz"]
    c: d
}))
  end

  def test_quoted_comma
    assert_equal(%{
a b[foo="bar, baz"] \{
  c: d; \}
}, render(%{
a
  b[foo="bar, baz"]
    c: d
}))
  end

  def test_quoted_ampersand
    assert_equal(%{
a b[foo="bar & baz"] \{
  c: d; \}
}, render(%{
a
  b[foo="bar & baz"]
    c: d
}))
  end

  def test_empty_selector_warning
    assert_warning(%{
WARNING on line 1 of test_empty_selector_warning_inline.sass:
This selector doesn't have any properties and will not be rendered.
}) {render("foo bar")}
  end

  def test_root_level_pseudo_class_with_new_properties
    assert_equal(%{
:focus \{
  outline: 0; \}
}, render(%{
:focus
  outline: 0
}, :property_syntax => :new))
  end

  def test_pseudo_class_with_new_properties
    assert_equal(%{
p :focus \{
  outline: 0; \}
}, render(%{
p
  :focus
    outline: 0
}, :property_syntax => :new))
  end

  def test_nil_option
    assert_equal(%{
foo \{
  a: b; \}
}, render(%{
foo
  a: b
}, :format => nil))
  end

  def test_interpolation_in_raw_functions
    assert_equal(%{
foo \{
  filter: progid:Microsoft.foo.bar.Baz(flip=foobar, bang=#00ff00cc); \}
}, render(%{
foo
  filter: progid:Microsoft.foo.bar.Baz(flip=\#{foo + bar}, bang=#00ff00cc)
}))
  end

  # SassScript string behavior

  def test_plus_preserves_quotedness
    assert_equal(%{
foo \{
  a: "foo1";
  b: "1foo";
  c: foo1;
  d: 1foo;
  e: "foobar";
  f: foobar; \}
}, render(%{
foo
  a: "foo" + 1
  b: 1 + "foo"
  c: foo + 1
  d: 1 + foo
  e: "foo" + bar
  f: foo + "bar"
}))
  end

  def test_colon_properties_preserve_quotedness
    assert_equal(%{
foo \{
  a: "foo";
  b: bar;
  c: "foo" bar;
  d: foo, "bar"; \}
}, render(%{
foo
  a: "foo"
  b: bar
  c: "foo" bar
  d: foo, "bar"
}))
  end

  def test_colon_variables_preserve_quotedness
    assert_equal(%{
foo \{
  a: "foo";
  b: bar; \}
}, render(%{
$a: "foo"
$b: bar

foo
  a: $a
  b: $b
}))
  end

  def test_colon_args_preserve_quotedness
    assert_equal(%{
foo \{
  a: "foo";
  b: bar;
  c: "foo" bar;
  d: foo, "bar"; \}
}, render(%{
=foo($a: "foo", $b: bar, $c: "foo" bar, $d: (foo, "bar"))
  foo
    a: $a
    b: $b
    c: $c
    d: $d

+foo
}))
  end

  def test_interpolation_unquotes_strings
    assert_equal(%{
.foo-bar \{
  a: b; \}
}, render(%{
.foo-\#{"bar"}
  a: b
}))

    assert_equal(%{
.foo \{
  a: b c; \}
}, render(%{
.foo
  a: b \#{"c"}
}))
  end

  def test_interpolation_unquotes_strings_in_vars
    assert_equal(%{
.foo-bar \{
  a: b; \}
}, render(%{
$var: "bar"

.foo-\#{$var}
  a: b
}))
  end

  def test_interpolation_doesnt_deep_unquote_strings
    assert_equal(%{
.foo- "bar" "baz" \{
  a: b; \}
}, render(%{
.foo-\#{"bar" "baz"}
  a: b
}))
  end

  # Deprecated equals behavior

  def test_equals_properties_unquote_strings
    silence_warnings do
      assert_equal(%{
foo \{
  a: foo;
  b: bar;
  c: foo bar;
  d: foo, bar baz;
  e: foo bar, bar; \}
}, render(%{
foo
  a= "foo"
  b= bar
  c= "foo" bar
  d= foo, "bar baz"
  e= "foo bar", bar
}))
    end
  end

  def test_equals_properties_unquote_value
    silence_warnings do
      assert_equal(%{
foo \{
  a: foo; \}
}, render(%{
$var: "foo"

foo
  a= $var
}))
    end
  end

  def test_equals_properties_deep_unquote_vars
    silence_warnings do
      assert_equal(%{
foo \{
  a: foo bar;
  b: bar foo; \}
}, render(%{
$var: "foo"

foo
  a= $var "bar"
  b= "bar" $var
}))
    end
  end

  def test_equals_vars_unquote_strings
    silence_warnings do
      assert_equal(%{
foo \{
  a: foo;
  b: bar;
  c: foo bar;
  d: foo, bar; \}
}, render(%{
$a = "foo"
$b = bar
$c = "foo" bar
$d = foo, "bar"

foo
  a: $a
  b: $b
  c: $c
  d: $d
}))
    end
  end

  def test_equals_vars_unquote_value
    silence_warnings do
      assert_equal(%{
foo \{
  a: foo; \}
}, render(%{
$var1: "foo"
$var2 = $var1

foo
  a: $var2
}))
    end
  end

  def test_equals_vars_deep_unquote_vars
    silence_warnings do
      assert_equal(%{
foo \{
  a: foo bar;
  b: bar foo; \}
}, render(%{
$var: "foo"
$a = $var "bar"
$b = "bar" $var

foo
  a: $a
  b: $b
}))
    end
  end

  def test_equals_args_unquote_strings
    silence_warnings do
      assert_equal(%{
foo \{
  a: foo;
  b: bar;
  c: foo bar;
  d: foo, bar; \}
}, render(%{
=foo($a = "foo", $b = bar, $c = "foo" bar, $d = (foo, "bar"))
  foo
    a: $a
    b: $b
    c: $c
    d: $d

+foo
}))
    end
  end

  def test_equals_args_unquote_value
    silence_warnings do
      assert_equal(%{
foo \{
  a: foo; \}
}, render(%{
$var1: "foo"

=foo($var2 = $var1)
  foo
    a: $var2

+foo
}))
    end
  end

  def test_equals_args_deep_unquote_vars
    silence_warnings do
      assert_equal(%{
foo \{
  a: foo bar;
  b: bar foo; \}
}, render(%{
$var: "foo"
=foo($a = $var "bar", $b = "bar" $var)
  foo
    a: $a
    b: $b

+foo
}))
    end
  end

  def test_equals_properties_force_division
    silence_warnings do
      assert_equal(%{
foo \{
  a: 0.5; \}
}, render(%{
foo
  a = 1px/2px
}))
    end
  end

  def test_warn_directive
  expected_warning = %{
WARNING: this is a warning
        on line 4 of test_warn_directive_inline.sass

WARNING: this is a mixin warning
        on line 2 of test_warn_directive_inline.sass, in `foo'
        from line 7 of test_warn_directive_inline.sass
}
    assert_warning expected_warning do
      assert_equal %{
bar \{
  c: d; \}
}, render(%{
=foo
  @warn "this is a mixin warning"

@warn "this is a warning"
bar
  c: d
  +foo
})
    end
  end

  def test_warn_directive_when_quiet
    assert_warning "" do
      assert_equal %{
}, render(%{
@warn "this is a warning"
}, :quiet => true)
    end
  end

  def test_warn_with_imports
    expected_warning = %{
}ING: In the main file
        on line 1 of #{File.dirname(__FILE__)}/templates/warn.sass

WARNING: Imported
        on line 1 of #{File.dirname(__FILE__)}/templates/warn_imported.sass
        from line 2 of #{File.dirname(__FILE__)}/templates/warn.sass

WARNING: In an imported mixin
        on line 4 of #{File.dirname(__FILE__)}/templates/warn_imported.sass, in `emits-a-warning'
        from line 3 of #{File.dirname(__FILE__)}/templates/warn.sass
WARN
    assert_warning expected_warning do
      renders_correctly "warn", :style => :compact, :load_paths => [File.dirname(__FILE__) + "/templates"]
    end
  end

  # Regression tests

  def test_parens_in_mixins
    assert_equal(%{
.foo \{
  color: #01ff7f;
  background-color: #000102; \}
}, render(%{
=foo($c1, $c2: rgb(0, 1, 2))
  color: $c1
  background-color: $c2

.foo
  +foo(rgb(1,255,127))
}))
  end

  def test_comment_beneath_prop
    assert_equal(%{
.box \{
  border-style: solid; \}
}, render(%{
.box
  :border
    //:color black
    :style solid
}))

    assert_equal(%{
.box \{
  /* :color black */
  border-style: solid; \}
}, render(%{
.box
  :border
    /* :color black
    :style solid
}))

    assert_equal(%{
.box\{border-style:solid\}
}, render(%{
.box
  :border
    /*:color black
    :style solid
}, :style => :compressed))
  end

  def test_compressed_comment_beneath_directive
    assert_equal(%{
@foo\{a:b\}
}, render(%{
@foo
  a: b
  /*b: c
}, :style => :compressed))
  end

  def test_comment_with_crazy_indentation
    assert_equal(%{
/* This is a loud comment:
 *          Where the indentation is wonky. */
.comment \{
  width: 1px; \}
}, render(%{
/*
  This is a loud comment:
           Where the indentation is wonky.
//
  This is a silent comment:
           Where the indentation is wonky.
.comment
  width: 1px
}))
  end

  def test_plus_with_space
    assert_equal(%{
a + b \{
  color: green; \}
}, render(%{
a
  + b
    color: green
}))
  end

  def test_empty_line_comment
    assert_equal(%{
/* Foo
 *
 * Bar */
}, render(%{
/*
  Foo

  Bar
}))
  end

  def test_empty_comment
    assert_equal(%{
/* */
a \{
  /* */
  b: c; \}
}, render(%{
/*
a
  /*
  b: c
}))
  end

  def test_options_available_in_environment
    assert_equal(%{
a \{
  b: nested; \}
}, render(%{
a
  b: option("style")
}))
  end

  def test_mixin_no_arg_error
    assert_raise(Sass::SyntaxError, 'Invalid CSS after "($bar,": expected variable name, was ")"') do
      render(%{
=foo($bar,)
  bip: bap
})
    end
  end

  # Encodings

  unless Haml::Util.ruby1_8?
    def test_encoding_error
      render("foo\nbar\nb\xFEaz".force_encoding("utf-8"))
      assert(false, "Expected exception")
    rescue Sass::SyntaxError => e
      assert_equal(3, e.sass_line)
      assert_equal('Invalid UTF-8 character "\xFE"', e.message)
    end

    def test_ascii_incompatible_encoding_error
      template = "foo\nbar\nb_z".encode("utf-16le")
      template[9] = "\xFE".force_encoding("utf-16le")
      render(template)
      assert(false, "Expected exception")
    rescue Sass::SyntaxError => e
      assert_equal(3, e.sass_line)
      assert_equal('Invalid UTF-16LE character "\xFE"', e.message)
    end

    def test_same_charset_as_encoding
      assert_renders_encoded(%{
@charset "utf-8";
fóó \{
  a: b; \}
}, %{
@charset "utf-8"
fóó
  a: b
})
    end

    def test_different_charset_than_encoding
      assert_renders_encoded(%{
@charset "ibm866";
fóó \{
  a: b; \}
}.force_encoding("IBM866"), %{
@charset "ibm866"
fóó
  a: b
})
    end

    def test_different_encoding_than_system
      assert_renders_encoded(%{
тАЬ \{
  a: b; \}
}.encode("IBM866"), %{
тАЬ
  a: b
}.encode("IBM866"))
    end

    def test_multibyte_charset
      assert_renders_encoded(%{
@charset "utf-16be";
fóó \{
  a: b; \}
}.encode("UTF-16BE"), %{
@charset "utf-16be"
fóó
  a: b
}.encode("UTF-16BE").force_encoding("UTF-8"))
    end

    def test_multibyte_charset_without_endian_specifier
      assert_renders_encoded(%{
@charset "utf-32";
fóó \{
  a: b; \}
}.encode("UTF-32LE"), %{
@charset "utf-32"
fóó
  a: b
}.encode("UTF-32LE").force_encoding("UTF-8"))
    end

    def test_utf8_bom
      assert_renders_encoded(%{
fóó \{
  a: b; \}
}, %{
\uFEFFfóó
  a: b
}.force_encoding("BINARY"))
    end

    def test_utf16le_bom
      assert_renders_encoded(%{
fóó \{
  a: b; \}
}.encode("UTF-16LE"), %{
\uFEFFfóó
  a: b
}.encode("UTF-16LE").force_encoding("BINARY"))
    end

    def test_utf32be_bom
      assert_renders_encoded(%{
fóó \{
  a: b; \}
}.encode("UTF-32BE"), %{
\uFEFFfóó
  a: b
}.encode("UTF-32BE").force_encoding("BINARY"))
    end
  end

         

  def assert_hash_has(hash, expected)
    expected.each {|k, v| assert_equal(v, hash[k])}
  end

  def assert_renders_encoded(css, sass)
    result = render(sass)
    assert_equal css.encoding, result.encoding
    assert_equal css, result
  end

  def render(sass, options = {})
    munge_filename options
    Sass::Engine.new(sass, options).render
  end

  def renders_correctly(name, options={})
    sass_file  = load_file(name, "sass")
    css_file   = load_file(name, "css")
    options[:filename] ||= filename(name, "sass")
    options[:css_filename] ||= filename(name, "css")
    css_result = Sass::Engine.new(sass_file, options).render
    assert_equal css_file, css_result
  end

  def load_file(name, type = "sass")
    @result = ''
    File.new(filename(name, type)).each_line { |l| @result += l }
    @result
  end

  def filename(name, type)
    File.dirname(__FILE__) + "/#{type == 'sass' ? 'templates' : 'results'}/#{name}.#{type}"
  end

  def sassc_path(template)
    sassc_path = File.join(File.dirname(__FILE__) + "/templates/#{template}.sass")
    Sass::Files.send(:sassc_filename, sassc_path, Sass::Engine::DEFAULT_OPTIONS)
  end
end
 


 