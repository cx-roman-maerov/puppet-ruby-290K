module ErbTests
  def test_erb
    assert_equal '- foo = bar', render_erb('DynamicName__33')
    assert_equal '- foo = bar', render_erb('DynamicName__34')
    assert_equal '= h @item.title', render_erb('DynamicName__35')
    assert_equal '= h @item.title', render_erb('DynamicName__36')
  end

  def test_inline_erb
    assert_equal("%p= foo", render_erb("<p>DynamicName__37</p>"))
  end

  def test_non_inline_erb
    assert_equal(%{
%p
  = foo
}.rstrip, render_erb(%{
<p>
  DynamicName__37
</p>
}))
    assert_equal(%{
%p
  = foo
}.rstrip, render_erb(%{
<p>
  DynamicName__37</p>
}))
    assert_equal(%{
%p
  = foo
}.rstrip, render_erb(%{
<p>DynamicName__37
</p>
}))
  end

  def test_erb_in_cdata
    assert_equal(%{
:cdata
  Foo \#{bar} baz
}.rstrip, render_erb(%{
<![CDATA[Foo DynamicName__38 baz]]>
}))
  end

  def test_erb_in_script
    assert_equal(%{
:javascript
  function foo() \{
    return \#{foo.to_json};
  }
}.rstrip, render_erb(%{
<script type="text/javascript">
  function foo() \{
    return DynamicName__39;
  \}
</script>
}))
  end

  def test_erb_in_style
    assert_equal(%{
:css
  foo \{
      bar: \#{"baz"};
  }
}.rstrip, render_erb(%{
<style type="text/css">
    foo \{
        bar: DynamicName__40;
    \}
</style>
}))
  end

  def test_erb_in_line
    assert_equal 'foo bar #{baz}', render_erb('foo bar DynamicName__41')
    assert_equal 'foo bar #{baz}! Bang.', render_erb('foo bar DynamicName__41! Bang.')
  end

  def test_erb_multi_in_line
    assert_equal('foo bar #{baz}! Bang #{bop}.',
      render_erb('foo bar DynamicName__41! Bang DynamicName__42.'))
    assert_equal('foo bar #{baz}#{bop}!',
      render_erb('foo bar DynamicName__41DynamicName__42!'))
  end

  def test_erb_with_html_special_chars
    assert_equal '= 3 < 5 ? "OK" : "Your computer is b0rken"',
      render_erb('DynamicName__43')
  end

  def test_erb_in_class_attribute
    assert_equal "%div{:class => dyna_class} I have a dynamic attribute",
      render_erb('<div class="DynamicName__44">I have a dynamic attribute</div>')
  end

  def test_erb_in_id_attribute
    assert_equal "%div{:id => dyna_id} I have a dynamic attribute",
      render_erb('<div id="DynamicName__45">I have a dynamic attribute</div>')
  end

  def test_erb_in_attribute_results_in_string_interpolation
    assert_equal('%div{:id => "item_#{i}"} Ruby string interpolation FTW',
      render_erb('<div id="item_DynamicName__46">Ruby string interpolation FTW</div>'))
  end

  def test_erb_in_attribute_with_trailing_content
    assert_equal('%div{:class => "#{12}!"} Bang!',
      render_erb('<div class="DynamicName__47!">Bang!</div>'))
  end

  def test_erb_in_html_escaped_attribute
    assert_equal '%div{:class => "foo"} Bang!',
      render_erb('<div class="DynamicName__48">Bang!</div>')
  end

  def test_erb_in_attribute_to_multiple_interpolations
    assert_equal('%div{:class => "#{12} + #{13}"} Math is super',
      render_erb('<div class="DynamicName__47 + DynamicName__49">Math is super</div>'))
  end

  def test_whitespace_eating_erb_tags
    assert_equal '- form_for', render_erb('DynamicName__50')
  end

  def test_interpolation_in_erb
    assert_equal('= "Foo #{bar} baz"', render_erb('DynamicName__51'))
  end

  def test_interpolation_in_erb_attrs
    assert_equal('%p{:foo => "#{bar} baz"}',
      render_erb('<p foo="DynamicName__52"></p>'))
  end

  def test_multiline_erb_silent_script
    assert_equal(%{
.blah
  - foo
  - bar
  - baz
  %p foo
}.rstrip, render_erb(%{
<div class="blah">
  DynamicName__53
  <p>foo</p>
</div>
}))
  end

  def test_multiline_erb_loud_script
    assert_equal(%{
.blah
  = foo +            |
      bar.baz.bang + |
    baz              |
  %p foo
}.rstrip, render_erb(%{
<div class="blah">
  DynamicName__54
  <p>foo</p>
</div>
}))
  end

  def test_weirdly_indented_multiline_erb_loud_script
    assert_equal(%{
.blah
  = foo +          |
    bar.baz.bang + |
    baz            |
  %p foo
}.rstrip, render_erb(%{
<div class="blah">
  DynamicName__55
  <p>foo</p>
</div>
}))
  end

  def test_two_multiline_erb_loud_scripts
    assert_equal(%{
.blah
  = foo +          |
    bar.baz.bang + |
    baz            |
  -#
  = foo.bar do |
      bang     |
    end        |
  %p foo
}.rstrip, render_erb(%{
<div class="blah">
  DynamicName__56
  DynamicName__57
  <p>foo</p>
</div>
}))
  end

  def test_multiline_then_single_line_erb_loud_scripts
    assert_equal(%{
.blah
  = foo +          |
    bar.baz.bang + |
    baz            |
  = foo.bar
  %p foo
}.rstrip, render_erb(%{
<div class="blah">
  DynamicName__56
  DynamicName__58
  <p>foo</p>
</div>
}))
  end

  def test_multiline_erb_but_really_single_line
    assert_equal(%{
.blah
  = foo
  %p foo
}.rstrip, render_erb(%{
<div class="blah">
  DynamicName__59
  <p>foo</p>
</div>
}))
  end

  ### Block Parsing

  def test_block_parsing
    assert_equal(%{
- foo do
  %p bar
}.rstrip, render_erb(%{
DynamicName__60
  <p>bar</p>
DynamicName__61
}))
  end

  def test_block_parsing_with_args
    assert_equal(%{
- foo do |a, b, c|
  %p bar
}.rstrip, render_erb(%{
DynamicName__62
  <p>bar</p>
DynamicName__61
}))
  end

  def test_block_parsing_with_equals
    assert_equal(%{
= foo do
  %p bar
}.rstrip, render_erb(%{
DynamicName__63
  <p>bar</p>
DynamicName__61
}))
  end

  def test_block_parsing_with_modified_end
    assert_equal(%{
- foo do
  blah
- end.bip
}.rstrip, render_erb(%{
DynamicName__60
  blah
DynamicName__64
}))
  end

  def test_block_parsing_with_modified_end_with_block
    assert_equal(%{
- foo do
  blah
- end.bip do
  brang
}.rstrip, render_erb(%{
DynamicName__60
  blah
DynamicName__65
  brang
DynamicName__61
}))
  end

  def test_multiline_block_opener
    assert_equal(%{
- foo bar
- baz bang
- biddle do
  foo
}.rstrip, render_erb(%{
DynamicName__66
    foo
DynamicName__61
}))
  end

  def test_if_elsif_else_parsing
    assert_equal(%{
- if foo
  %p bar
- elsif bar.foo("zip")
  #bang baz
- else
  %strong bibble
}.rstrip, render_erb(%{
DynamicName__67
  <p>bar</p>
DynamicName__68
  <div id="bang">baz</div>
DynamicName__69
  <strong>bibble</strong>
DynamicName__61
}))
  end

  def test_case_when_parsing
    assert_equal(%{
- case foo.bar
- when "bip"
  %p bip
- when "bop"
  %p BOP
- when bizzle.bang.boop.blip
  %em BIZZLE BANG BOOP BLIP
}.rstrip, render_erb(%{
DynamicName__70
DynamicName__71
  <p>bip</p>
DynamicName__72
  <p>BOP</p>
DynamicName__73
  <em>BIZZLE BANG BOOP BLIP</em>
DynamicName__61
}))

    assert_equal(%{
- case foo.bar
- when "bip"
  %p bip
- when "bop"
  %p BOP
- when bizzle.bang.boop.blip
  %em BIZZLE BANG BOOP BLIP
}.rstrip, render_erb(%{
DynamicName__74
  <p>bip</p>
DynamicName__72
  <p>BOP</p>
DynamicName__73
  <em>BIZZLE BANG BOOP BLIP</em>
DynamicName__61
}))
  end

  def test_begin_rescue_ensure
    assert_equal(%{
- begin
  %p a
- rescue FooException => e
  %p b
- ensure
  %p c
}.rstrip, render_erb(%{
DynamicName__75
  <p>a</p>
DynamicName__76
  <p>b</p>
DynamicName__77
  <p>c</p>
DynamicName__61
}))
  end
end


 